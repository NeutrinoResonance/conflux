{"source":"agent_flows.yaml","agents":[{"id":"executor","label":"Executor","role":"proposes work and incorporates observed tool evidence","description":"The routed task model. It never authorizes its own side effects.","model_selector":"routed executor","family_rule":"selected per turn","capabilities":["propose_action","synthesize"],"accent":"cobalt","icon":"spark"},{"id":"governor","label":"Action governor","role":"deterministic policy and capability boundary","description":"Validates schemas and exact targets, assigns risk, and enforces hard policy.","model_selector":"deterministic","family_rule":"","capabilities":["inspect_proposal","classify_risk","release_action","inspect_result"],"accent":"amber","icon":"shield"},{"id":"critic","label":"Independent critic","role":"makes the strongest contextual case against uncertain actions","description":"A bounded, cross-family review identity with no execution capability.","model_selector":"cross-family verifier pool","family_rule":"different from executor","capabilities":["review_action","propose_safe_probe"],"accent":"violet","icon":"eye"},{"id":"soundness","label":"Soundness checker","role":"devises a falsification test, interprets it, and returns learned evidence","description":"An independent identity that turns postconditions into one bounded read-only experiment before the executor continues.","model_selector":"cross-family verifier pool","family_rule":"different from executor","capabilities":["design_soundness_test","interpret_soundness_evidence"],"accent":"cyan","icon":"flask"},{"id":"verifier","label":"Outcome verifier","role":"checks final claims against observed evidence","description":"Existing evidence-first, cross-family final-answer verification.","model_selector":"cross-family verifier pool","family_rule":"different from executor","capabilities":["review_outcome"],"accent":"emerald","icon":"check"},{"id":"operator","label":"Human operator","role":"resolves irreversible or ambiguous action boundaries","desc