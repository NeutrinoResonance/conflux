","loop":false},{"source":"action_critic","target":"blocked","label":"block","condition":"concrete objection","loop":false},{"source":"preflight","target":"action_critic","label":"evidence","condition":"probe result","loop":true},{"source":"preflight","target":"action_released","label":"pass","condition":"deterministic preflight passes","loop":false},{"source":"preflight","target":"blocked","label":"fail","condition":"preflight fails","loop":false},{"source":"human_approval","target":"action_released","label":"approve","condition":"explicit operator approval","loop":false},{"source":"human_approval","target":"blocked","label":"deny","condition":"operator denial","loop":false},{"source":"action_released","target":"client_tool","label":"","condition":"","loop":false},{"source":"client_tool","target":"postcheck","label":"","condition":"","loop":false},{"source":"postcheck","target":"executor","label":"deterministic result","condition":"low risk or explicit failure","loop":true},{"source":"postcheck","target":"soundness_checker","label":"test the claim","condition":"meaningful action passed","loop":false},{"source":"soundness_checker","target":"soundness_probe","label":"run test","condition":"independent evidence needed","loop":false},{"source":"soundness_probe","target":"soundness_checker","label":"observed evidence","condition":"one probe result","loop":true},{"source":"soundness_checker","target":"executor","label":"add learning","condition":"accept or recover","loop":true},{"source":"final_verifier","target":"executor","label":"bounded repair","condition":"failed review","loop":true},{"source":"final_verifier","target":"completed","label":"pass","condition":"verified","loop":false}],"capabilities":["propose_action","synthesize","inspect_proposal","classify_risk","release_action","review_action","propose_safe_probe","client_tool_execution","inspect_result","design_soundness_test","interpret_soundness_evidence","review_outcome","approve_high_risk","block_action"],"bud