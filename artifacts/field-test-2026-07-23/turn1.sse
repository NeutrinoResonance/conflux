data: {"id": "chatcmpl-d719464069b645c68ed0d8c6", "object": "chat.completion.chunk", "created": 1784791045, "model": "super", "choices": [{"index": 0, "delta": {"content": "00\n    >>> parse_duration(\"malformed\")\n    Traceback (most recent call last):\n        ...\n    ValueError: malformed duration\n    \"\"\"\n    pattern = r'^(?:(\\d+)h)?(?:(\\d+)m)?(?:(\\d+)s)?$'\n    match = re.match(pattern, text)\n    if not match:\n        raise ValueError(\"malformed duration\")\n\n    hours_str, minutes_str, seconds_str = match.groups()\n\n    # at least one component must be present\n    if hours_str is None and minutes_str is None and seconds_str is None:\n        raise ValueError(\"malformed duration\")\n"}, "finish_reason": null}]}

